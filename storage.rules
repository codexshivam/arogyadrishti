rules_version = '2';

// NidanIQ — Sovereign Storage Security Rules (Government of Nepal / IDMC Singha Durbar)
// Enforces authenticated image-only uploads <= 10MB for breeding-site scans under Individual Privacy Act, 2075.
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAuthorizedStaff() {
      return isAuthenticated() &&
        request.auth.token.role in ['fchv', 'ward_health_officer', 'palika_health_chief', 'edcd_nodal'];
    }

    function isValidBreedingScanImage() {
      return request.resource != null &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /scans/{compositeWardId}/{scanFile} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthorizedStaff() && isValidBreedingScanImage();
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
