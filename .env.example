# Copy to backend/.env for local development ONLY. In production every value
# comes from Google Secret Manager and Cloud Run Workload Identity (no key files).

# --- GCP / data sovereignty (asia-south1 = Mumbai) ---
GCP_PROJECT_ID=teamrocketnp
GCP_REGION=asia-south1
# Local dev only. Point to a key file OUTSIDE the repo, e.g. ~/.config/arogyadrishti/...
GOOGLE_APPLICATION_CREDENTIALS=
GCS_SCAN_BUCKET=teamrocketnp-arogya-scans-south1
VERTEX_AI_PROJECT_ID=teamrocketnp
VERTEX_AI_LOCATION=asia-south1
GEMINI_MODEL_ID=gemini-3.8-flash
GOOGLE_AI_API_KEY=

# --- Google Sheets master ledger ---
MASTER_SPREADSHEET_ID=

# --- Google Maps Platform (Routes API v2) ---
GOOGLE_MAPS_API_KEY=

# --- Open Government Data India ---
DATA_GOV_IN_API_KEY=

# --- Open-weight model (Gemma 4 on vLLM, Cloud Run L4, asia-south1) ---
# One multimodal model handles agent chat + breeding-site object detection.
GEMMA_ENDPOINT_URL=
GEMMA_MODEL_ID=google/gemma-4-12B-it

# --- Alert email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_ADDRESS=

# --- Security ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
PUBLIC_API_RATE_LIMIT=60/minute
