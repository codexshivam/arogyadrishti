# ==============================================================================
# NidanIQ — Government of Nepal Sovereign Vector Surveillance & Early Warning DPI
# Ministry of Health and Population (MoHP) | EDCD Teku | 753 Local Levels (Palikas)
# Data Center: IDMC Singha Durbar (Primary) & Hetauda (DR) — DCCS Directive 2081
# ==============================================================================

ENV=development
SOVEREIGN_DATACENTER_ID=IDMC-SINGHA-DURBAR-NP-01
DR_DATACENTER_ID=IDMC-HETAUDA-NP-02
TIMEZONE=Asia/Kathmandu
DEFAULT_PALIKA_CODE=30608
DATABASE_URL=postgresql+asyncpg://mohp_dpi:sovereign_singha_durbar@localhost:5432/nidaniq_nepal
REDIS_URL=redis://localhost:6379/0
JWT_ALGORITHM=EdDSA
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SMS_PROVIDER=sparrow
SPARROW_SMS_API_URL=https://api.sparrowsms.com/v2/sms/
SMS_SHORTCODE=31115
BIPAD_PORTAL_API_URL=https://bipadportal.gov.np/api/v1/incidents
DHM_AWS_API_URL=https://dhm.gov.np/api/v1/aws-telemetry
ELMIS_API_BASE_URL=https://elmis.mohp.gov.np/api/v1
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_WORM=edcd-worm-audit-ledger
VLLM_BASE_URL=http://localhost:8000/v1
GEMMA_MODEL_ID=google/gemma-4-12b-it
PALIGEMMA_MODEL_ID=google/paligemma-3b-mix-448
OSRM_BASE_URL=http://localhost:5000
DHIS2_IHMIS_BASE_URL=https://hmis.gov.np/hmis
CORS_ALLOWED_ORIGINS=https://edcd.gov.np,https://mohp.gov.np,https://kathmandu.gov.np,http://localhost:3000,http://localhost:8080
